# 服务监听地址
ARK_LISTEN_ADDR=:5656

# 配置与数据库目录（Docker 内固定挂载 /config）
ARK_DATA_DIR=data

# 可选：统一工作根目录（Docker 内挂载 /data，自动创建 watch/output/cache/archive）
# ARK_WORK_DIR=/data

# 时区
ARK_TZ=Asia/Shanghai

# 日志级别：debug / info / warn / error
ARK_LOG_LEVEL=info

# 内网 Web 后台是否免登录（如暴露公网请设为 false 并在后台设置密码）
ARK_NO_AUTH=true

# Go 软内存上限（MB），默认 48，配合 Docker 限制可将空闲内存压在 15-25MB
ARK_MEM_LIMIT_MB=48

# 7-Zip 可执行文件路径（留空则自动探测 7zz / 7z）
# ARK_EXTRACT_BIN=/usr/local/bin/7zz

# 本地解压允许的最大字典大小（MB），0 表示不限制；死守 100MB 容器硬上限可设为 48
ARK_EXTRACT_MAX_DICT_MB=0

# 本地解压要求目标分区最少保留可用空间（MB）
ARK_EXTRACT_RESERVE_MB=64
